---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import LiveStats from '../components/LiveStats.astro';
---
<BaseLayout title="Connect. Protect. Grow." description="CYBERDUDEBIVASH Connect Hub - India's 1st AI-Native Cybersecurity Platform.">
  <NavBar />
  <Hero />
  <LiveStats />
  <section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">Our Services</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { title: 'Managed Detection and Response', desc: '24/7 SOC monitoring and threat hunting.' },
          { title: 'Threat Hunt-as-a-Service', desc: 'Fixed-scope hunts for hidden threats.' },
          { title: 'IR Retainer', desc: 'Rapid incident response when it matters.' },
          { title: 'Zero Trust Architecture', desc: 'Identity-first security design.' },
          { title: 'API Security Audit', desc: 'Find misconfigurations before attackers do.' },
          { title: 'DDoS Readiness and WAF', desc: 'Protect uptime and customer trust.' },
        ].map(s => (
          <div class="bg-[#1A2F4A]/50 p-6 rounded-xl border border-[#1A2F4A] hover:border-[#00B4D8]">
            <h3 class="font-semibold text-lg">{s.title}</h3>
            <p class="text-sm text-gray-400 mt-2">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="py-20 px-6 bg-[#050F1A]">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold">Ready to Secure Your Business?</h2>
      <p class="text-gray-400 mt-4">Book a free 15-minute security posture review.</p>
      <a href="/contact" class="inline-block mt-8 px-8 py-3 bg-[#00B4D8] text-[#0A1929] font-semibold rounded-lg">Book a Free Call</a>
    </div>
  </section>
  <Footer />
</BaseLayout>
