---
const year = new Date().getFullYear();

const platformLinks = [
  { label: 'AI Security Hub',   url: 'https://cyberdudebivash.in' },
  { label: 'Sentinel APEX',     url: 'https://intel.cyberdudebivash.com' },
  { label: 'Threat Intel APIs', url: 'https://cyberdudebivash.in/api/' },
  { label: 'Tools Store',       url: 'https://tools.cyberdudebivash.com' },
  { label: 'Threat Intel Blog', url: 'https://blog.cyberdudebivash.in' },
  { label: 'Cyber Academy',     url: 'https://academy.cyberdudebivash.com' },
  { label: 'CTI Platform',      url: 'https://cti.cyberdudebivash.in' },
  { label: 'Labs',              url: 'https://labs.cyberdudebivash.in' },
  { label: 'TrustX',            url: 'https://trustx.cyberdudebivash.com' },
  { label: 'Corporate',         url: 'https://cyberdudebivash.com' },
];

const companyLinks = [
  { label: 'Services',       href: '/services' },
  { label: 'Products',       href: '/products' },
  { label: 'Pricing',        href: '/pricing' },
  { label: 'Press',          href: '/press' },
  { label: 'Case Studies',   href: '/case-studies' },
  { label: 'Contact',        href: '/contact' },
];

const connectLinks = [
  { label: 'contact@cyberdudebivash.in', href: 'mailto:contact@cyberdudebivash.in' },
  { label: 'bivash@cyberdudebivash.com', href: 'mailto:bivash@cyberdudebivash.com' },
  { label: '+91 8179881447',             href: 'tel:+918179881447' },
  { label: 'WhatsApp',                   href: 'https://wa.me/918179881447' },
  { label: 'LinkedIn',                   href: 'https://www.linkedin.com/company/cyberdudebivash/' },
  { label: 'X (Twitter)',                href: 'https://x.com/cyberbivash' },
];
---

<footer class="relative bg-[var(--color-abyss)] border-t border-[var(--color-border)]">
  <div class="absolute inset-0 bg-grid opacity-20 pointer-events-none"></div>

  <div class="relative max-w-[1400px] mx-auto px-6 py-16 lg:py-20">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-14">

      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-md bg-gradient-to-br from-[var(--color-brand)] to-[var(--color-ai)] grid place-items-center">
            <span class="font-mono text-[10px] font-bold text-[var(--color-void)]">CDB</span>
          </div>
          <div class="flex flex-col leading-none">
            <span class="text-sm font-bold tracking-tight text-ink">CYBERDUDEBIVASH</span>
            <span class="text-[10px] font-mono text-ink-muted tracking-wider uppercase">Connect Hub</span>
          </div>
        </div>
        <p class="text-sm text-ink-soft leading-relaxed mb-5">
          India's 1st AI-Native Cybersecurity Platform. Delivering threat intelligence, SOC operations, and enterprise cyber defense worldwide.
        </p>
        <div class="flex items-center gap-2 text-xs font-mono">
          <span class="pulse-live"></span>
          <span class="text-[var(--color-success)]">ALL SYSTEMS OPERATIONAL</span>
        </div>
      </div>

      <div>
        <div class="text-[10px] font-mono text-ink-muted uppercase tracking-wider mb-4">Platforms</div>
        <ul class="space-y-2.5">
          {platformLinks.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener" class="text-sm text-ink-soft hover:text-[var(--color-brand)] transition-colors inline-flex items-center gap-1 group">
                {item.label}
                <span class="text-[10px] text-ink-faint group-hover:text-[var(--color-brand)] transition-colors">Ã¢" "”</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class="text-[10px] font-mono text-ink-muted uppercase tracking-wider mb-4">Company</div>
        <ul class="space-y-2.5">
          {companyLinks.map((item) => (
            <li><a href={item.href} class="text-sm text-ink-soft hover:text-[var(--color-brand)] transition-colors">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <div class="text-[10px] font-mono text-ink-muted uppercase tracking-wider mb-4">Connect</div>
        <ul class="space-y-2.5">
          {connectLinks.map((item) => (
            <li>
              <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noopener' : undefined}
                 class="text-sm text-ink-soft hover:text-[var(--color-brand)] transition-colors font-mono">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-6 pt-5 border-t border-[var(--color-border)]">
          <div class="text-[10px] font-mono text-ink-muted uppercase tracking-wider mb-2">Registered Office</div>
          <div class="text-xs text-ink-soft leading-relaxed">
            Ragadi, Jajpur Road<br/>
            Odisha 755019, India
          </div>
        </div>
      </div>

    </div>

    <div class="pt-8 border-t border-[var(--color-border)] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
      <div class="text-xs text-ink-muted">
        &copy; {year} CYBERDUDEBIVASH ECOSYSTEM Ã‚| GSTIN 21ARKPN8270G1ZP Ã‚| All rights reserved.
      </div>
      <div class="flex items-center gap-6 text-xs font-mono text-ink-muted">
        <a href="/privacy" class="hover:text-[var(--color-brand)] transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-[var(--color-brand)] transition-colors">Terms</a>
        <a href="/security" class="hover:text-[var(--color-brand)] transition-colors">Security</a>
      </div>
    </div>
  </div>
</footer>