---
import ServiceCard from './ServiceCard.astro';

const services = [
  { icon: '🎯', title: 'Managed Detection & Response',   description: '24/7 SOC monitoring and threat hunting across your entire attack surface.' },
  { icon: '🔎', title: 'Threat Hunt-as-a-Service',       description: 'Fixed-scope hunts for hidden threats that evade automated detection.' },
  { icon: '🚨', title: 'IR Retainer',                    description: 'Rapid incident response when it matters most -- 15-minute SLA.' },
  { icon: '🔐', title: 'Zero Trust Architecture',        description: 'Identity-first security design for modern distributed enterprises.' },
  { icon: '🛡', title: 'API Security Audit',             description: 'Find misconfigurations before attackers do -- full OWASP coverage.' },
  { icon: '⚡', title: 'DDoS Readiness & WAF',           description: 'Protect uptime and customer trust with always-on mitigation.' },
];
---

<section id="services" class="relative py-24 lg:py-32 bg-void">
  <div class="max-w-[1400px] mx-auto px-6">
    <div class="reveal max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass mb-6 text-xs font-mono text-ink-muted tracking-wider">
        <span class="text-[var(--color-brand)]">*</span> OUR SERVICES
      </div>
      <h2 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-6">
        Enterprise security, <span class="text-gradient-cyan">end to end.</span>
      </h2>
      <p class="text-lg text-ink-soft leading-relaxed">
        Six production-grade cybersecurity services engineered for modern threat landscapes. All backed by our AI-native Sentinel APEX intel engine.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {services.map((svc, i) => <ServiceCard {...svc} index={i} />)}
    </div>
  </div>
</section>