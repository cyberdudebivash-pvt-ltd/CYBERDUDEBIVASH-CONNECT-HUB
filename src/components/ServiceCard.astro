---
interface Props {
  title: string;
  description: string;
  icon: string;
  index?: number;
}
const { title, description, icon, index = 0 } = Astro.props;
---

<div class="reveal group relative glass glass-hover rounded-xl p-6 lg:p-7"
     style={`transition-delay: ${Math.min(index * 60, 400)}ms`}>
  <div class="w-11 h-11 rounded-lg bg-gradient-to-br from-[var(--color-brand)]/20 to-[var(--color-ai)]/20 border border-[var(--color-border-hi)] grid place-items-center text-xl mb-5 group-hover:border-[var(--color-brand)] transition-colors">
    {icon}
  </div>
  <h3 class="font-display text-lg font-bold text-ink mb-2 group-hover:text-[var(--color-brand)] transition-colors">{title}</h3>
  <p class="text-sm text-ink-soft leading-relaxed">{description}</p>
  <div class="absolute bottom-0 left-6 right-6 h-px bg-gradient-to-r from-transparent via-[var(--color-brand)] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>