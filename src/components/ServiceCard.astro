---
interface Props {
  title: string;
  description: string;
  price: string;
  icon: string;
}
const { title, description, price, icon } = Astro.props;
---
<div class="bg-[#1A2F4A]/50 p-6 rounded-xl border border-[#1A2F4A] hover:border-[#00B4D8] transition-colors">
  <div class="text-3xl mb-3">{icon}</div>
  <h3 class="font-semibold text-lg text-white">{title}</h3>
  <p class="text-sm text-gray-400 mt-2">{description}</p>
  <p class="text-[#00B4D8] text-sm font-semibold mt-4">{price}</p>
</div>