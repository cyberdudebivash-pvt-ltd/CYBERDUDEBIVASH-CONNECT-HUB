---
---

<section class="relative overflow-hidden bg-void">
  <div class="orb orb-cyan w-[600px] h-[600px] -top-40 -left-40"></div>
  <div class="orb orb-purple w-[500px] h-[500px] top-20 -right-40"></div>
  <div class="absolute inset-0 bg-grid opacity-40"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--color-void)]"></div>

  <div class="relative max-w-[1400px] mx-auto px-6 pt-24 pb-32 lg:pt-32 lg:pb-40">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass border-[var(--color-border-hi)] mb-6">
          <span class="pulse-live"></span>
          <span class="text-xs font-mono text-ink-soft tracking-wider">LIVE · GLOBAL THREAT INTELLIGENCE</span>
        </div>

        <h1 class="font-display text-5xl lg:text-7xl font-extrabold tracking-tight leading-[1.05] mb-6">
          <span class="text-ink">Connect.</span>{' '}
          <span class="text-gradient-cyan">Protect.</span>{' '}
          <span class="text-ink">Grow.</span>
        </h1>

        <p class="text-lg lg:text-xl text-ink-soft max-w-2xl leading-relaxed mb-8">
          India's <span class="text-ink font-semibold">#1 AI-Native Cybersecurity Platform</span> — delivering
          <span class="text-[var(--color-brand)]">real-time threat intelligence</span>,
          <span class="text-[var(--color-brand)]">SOC operations</span>, and
          <span class="text-[var(--color-brand)]">enterprise cyber defense</span> worldwide.
        </p>

        <div class="flex flex-wrap items-center gap-4 mb-10">
          <a href="#book" class="group px-6 py-3.5 rounded-md bg-[var(--color-brand)] text-[var(--color-void)] font-semibold text-sm hover:bg-[var(--color-brand-dim)] transition-all duration-200 shadow-[0_0_30px_-8px_var(--color-brand-glow)] flex items-center gap-2">
            <span>Book Free Security Scan</span>
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href="#ecosystem" class="px-6 py-3.5 rounded-md border border-[var(--color-border-hi)] text-ink font-semibold text-sm hover:border-[var(--color-brand)] hover:bg-[var(--color-surface)] transition-all duration-200">
            Explore Platform
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-ink-muted">
          <div class="flex items-center gap-2"><span class="text-[var(--color-warning)]">★</span><span class="text-ink font-semibold">5.0</span><span>Google Rating</span></div>
          <div class="flex items-center gap-2"><span class="text-[var(--color-brand)]">◆</span><span class="text-ink font-semibold">265+</span><span>Business Interactions</span></div>
          <div class="flex items-center gap-2"><span class="text-[var(--color-success)]">●</span><span>Serving Globally</span></div>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="glass rounded-2xl p-6 border-[var(--color-border-hi)] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.8)]">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-[var(--color-border)]">
            <div class="flex items-center gap-2"><span class="pulse-live"></span><span class="text-xs font-mono text-ink-soft tracking-wider uppercase">Sentinel APEX Feed</span></div>
            <span class="text-[10px] font-mono text-ink-faint">v1.0</span>
          </div>

          <div class="space-y-4 mb-6">
            <div class="flex items-baseline justify-between">
              <span class="text-xs font-mono text-ink-muted uppercase tracking-wider">CVEs Tracked Today</span>
              <span class="font-display text-3xl font-bold text-[var(--color-brand)]">260</span>
            </div>
            <div class="flex items-baseline justify-between">
              <span class="text-xs font-mono text-ink-muted uppercase tracking-wider">Critical Threats</span>
              <span class="font-display text-3xl font-bold text-[var(--color-danger)]">17</span>
            </div>
            <div class="flex items-baseline justify-between">
              <span class="text-xs font-mono text-ink-muted uppercase tracking-wider">SOC Uptime</span>
              <span class="font-display text-3xl font-bold text-[var(--color-success)]">99.99%</span>
            </div>
          </div>

          <div class="rounded-lg bg-[var(--color-void)] border border-[var(--color-border)] p-3 overflow-hidden">
            <div class="text-[10px] font-mono text-ink-faint uppercase tracking-wider mb-2">// Latest CVEs</div>
            <div class="marquee">
              <div class="marquee-track text-xs font-mono">
                <span class="text-ink-soft">CVE-2026-38104 <span class="text-[var(--color-danger)]">· CRITICAL · 9.8</span></span>
                <span class="text-ink-soft">CVE-2026-38771 <span class="text-[var(--color-warning)]">· HIGH · 8.2</span></span>
                <span class="text-ink-soft">CVE-2026-39120 <span class="text-[var(--color-danger)]">· CRITICAL · 9.6</span></span>
                <span class="text-ink-soft">CVE-2026-38294 <span class="text-[var(--color-warning)]">· MED · 6.4</span></span>
                <span class="text-ink-soft">CVE-2026-39011 <span class="text-[var(--color-warning)]">· HIGH · 7.9</span></span>
              </div>
              <div class="marquee-track text-xs font-mono" aria-hidden="true">
                <span class="text-ink-soft">CVE-2026-38104 <span class="text-[var(--color-danger)]">· CRITICAL · 9.8</span></span>
                <span class="text-ink-soft">CVE-2026-38771 <span class="text-[var(--color-warning)]">· HIGH · 8.2</span></span>
                <span class="text-ink-soft">CVE-2026-39120 <span class="text-[var(--color-danger)]">· CRITICAL · 9.6</span></span>
                <span class="text-ink-soft">CVE-2026-38294 <span class="text-[var(--color-warning)]">· MED · 6.4</span></span>
                <span class="text-ink-soft">CVE-2026-39011 <span class="text-[var(--color-warning)]">· HIGH · 7.9</span></span>
              </div>
            </div>
          </div>

          <div class="mt-4 flex items-center justify-between text-[10px] font-mono text-ink-faint">
            <span>SOURCE: SENTINEL APEX</span>
            <span>LATENCY: 42ms</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>