---
---
<form id="contact-form" class="space-y-4 max-w-2xl mx-auto">
  <div class="grid md:grid-cols-2 gap-4">
    <input type="text" name="name" required placeholder="Your Name *" class="w-full px-4 py-3 bg-[#1A2F4A]/50 border border-[#1A2F4A] rounded-lg text-white placeholder-gray-500 focus:border-[#00B4D8] focus:outline-none" />
    <input type="email" name="email" required placeholder="Email Address *" class="w-full px-4 py-3 bg-[#1A2F4A]/50 border border-[#1A2F4A] rounded-lg text-white placeholder-gray-500 focus:border-[#00B4D8] focus:outline-none" />
  </div>
  <div class="grid md:grid-cols-2 gap-4">
    <input type="text" name="company" placeholder="Company" class="w-full px-4 py-3 bg-[#1A2F4A]/50 border border-[#1A2F4A] rounded-lg text-white placeholder-gray-500 focus:border-[#00B4D8] focus:outline-none" />
    <input type="tel" name="phone" placeholder="Phone / WhatsApp" class="w-full px-4 py-3 bg-[#1A2F4A]/50 border border-[#1A2F4A] rounded-lg text-white placeholder-gray-500 focus:border-[#00B4D8] focus:outline-none" />
  </div>
  <select name="service_interest" class="w-full px-4 py-3 bg-[#1A2F4A]/50 border border-[#1A2F4A] rounded-lg text-white focus:border-[#00B4D8] focus:outline-none">
    <option value="">What are you interested in?</option>
    <option value="mdr">Managed Detection & Response (MDR)</option>
    <option value="threat-hunt">Threat Hunt-as-a-Service</option>
    <option value="ir-retainer">Incident Response Retainer</option>
    <option value="zero-trust">Zero Trust Architecture</option>
    <option value="api-audit">API Security Audit</option>
    <option value="ddos">DDoS Readiness & WAF</option>
    <option value="other">Other</option>
  </select>
  <textarea name="message" rows="5" placeholder="Tell us about your security needs..." class="w-full px-4 py-3 bg-[#1A2F4A]/50 border border-[#1A2F4A] rounded-lg text-white placeholder-gray-500 focus:border-[#00B4D8] focus:outline-none resize-none"></textarea>
  <button type="submit" class="w-full py-3 bg-[#00B4D8] text-[#0A1929] font-semibold rounded-lg hover:bg-[#00E676] transition-colors">
    Send Message
  </button>
  <p id="form-status" class="text-center text-sm hidden"></p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    status.textContent = 'Sending...';
    status.className = 'text-center text-sm text-gray-400 mt-4';

    try {
      const res = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        status.textContent = '✓ Thank you! We will get back to you within 24 hours.';
        status.className = 'text-center text-sm text-[#00E676] mt-4';
        form.reset();
      } else {
        throw new Error('Failed');
      }
    } catch {
      status.textContent = '⚠ Something went wrong. Please email contact@cyberdudebivash.in';
      status.className = 'text-center text-sm text-red-400 mt-4';
    }
  });
</script>