<section id="book" class="relative py-24 lg:py-32 overflow-hidden bg-void">
  <div class="orb orb-cyan w-[500px] h-[500px] -top-20 -left-40 opacity-20"></div>
  <div class="orb orb-purple w-[500px] h-[500px] -bottom-40 -right-40 opacity-20"></div>

  <div class="relative max-w-[1200px] mx-auto px-6">
    <div class="reveal glass rounded-2xl p-10 lg:p-16 border-[var(--color-border-hi)] text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-brand)]/10 border border-[var(--color-brand)]/30 mb-6 text-xs font-mono text-[var(--color-brand)] tracking-wider">
        <span class="pulse-live"></span> READY TO SECURE YOUR AI?
      </div>

      <h2 class="font-display text-4xl lg:text-6xl font-bold tracking-tight mb-6">
        Book a <span class="text-gradient-cyan">free 15-minute</span> security posture review.
      </h2>

      <p class="text-lg text-ink-soft max-w-2xl mx-auto leading-relaxed mb-10">
        Talk directly with a senior cybersecurity engineer. No sales pitch. Just an honest assessment of your current threat exposure.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="https://wa.me/918179881447?text=Hi%2C%20I%27d%20like%20to%20book%20a%20free%20security%20posture%20review"
           target="_blank" rel="noopener"
           class="group px-7 py-4 rounded-md bg-[var(--color-brand)] text-[var(--color-void)] font-semibold text-sm hover:bg-[var(--color-brand-dim)] transition-all duration-200 shadow-[0_0_40px_-8px_var(--color-brand-glow)] inline-flex items-center gap-2">
          <span>Book via WhatsApp</span>
          <span class="transition-transform group-hover:translate-x-0.5">-></span>
        </a>
        <a href="mailto:contact@cyberdudebivash.in?subject=Security%20Posture%20Review"
           class="px-7 py-4 rounded-md border border-[var(--color-border-hi)] text-ink font-semibold text-sm hover:border-[var(--color-brand)] hover:bg-[var(--color-surface)] transition-all duration-200">
          Email Us
        </a>
      </div>

      <div class="mt-10 pt-8 border-t border-[var(--color-border)] flex flex-wrap items-center justify-center gap-x-10 gap-y-3 text-xs font-mono text-ink-muted">
        <span>⚡ 15-MINUTE SLA RESPONSE</span>
        <span>🔒 NDA ON REQUEST</span>
        <span>🌍 SERVING GLOBALLY</span>
      </div>
    </div>
  </div>
</section>